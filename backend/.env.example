APP_NAME=Atlas API
API_PREFIX=/api
ENVIRONMENT=development

# Application process: restricted runtime role, never the migration owner.
DATABASE_URL=postgresql+psycopg://hiatlas_runtime:CHANGE_ME@localhost:5433/atlas

# Migration process only; do not inject owner credentials into the web process.
MIGRATION_DATABASE_URL=postgresql+psycopg://hiatlas_owner:CHANGE_ME@localhost:5433/atlas
DATABASE_RUNTIME_ROLE=hiatlas_runtime

# Dedicated disposable integration-test database; never use application data.
# TEST_DATABASE_OWNER_URL=postgresql+psycopg://hiatlas_test_owner:CHANGE_ME@localhost:5433/hiatlas_foundation_test
# TEST_DATABASE_RUNTIME_URL=postgresql+psycopg://hiatlas_test_runtime:CHANGE_ME@localhost:5433/hiatlas_foundation_test
# HIATLAS_TEST_DATABASE_RESET=1

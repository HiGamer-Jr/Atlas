# Development only. Production builds never include the demo entry.
VITE_ENABLE_DEMO=false
# Set these in the Vite process environment (see docs/operations/hiatlas-frontend.md).
HIATLAS_API_TARGET=http://127.0.0.1:8000
# Login requires HTTPS. Paths point to your locally trusted certificate/key.
# HIATLAS_TLS_CERT=C:/path/to/localhost.crt
# HIATLAS_TLS_KEY=C:/path/to/localhost.key
